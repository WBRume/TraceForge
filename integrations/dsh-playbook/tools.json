[
  {
    "name": "propose_hypotheses",
    "description": "提交二至三个可证伪假说与候选判别脚本。此工具不会标记验证通过。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypotheses"
      ],
      "properties": {
        "hypotheses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claim",
              "predictions",
              "falsifiers",
              "discriminator_script"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "predictions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "falsifiers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "discriminator_script": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "accepted"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "error",
              "default": "error",
              "title": "Kind",
              "type": "string"
            },
            "code": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Code",
              "type": "string"
            },
            "category": {
              "enum": [
                "input",
                "condition",
                "conflict",
                "revoked",
                "transient",
                "uncertain",
                "internal"
              ],
              "title": "Category",
              "type": "string"
            },
            "message": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Message",
              "type": "string"
            },
            "action": {
              "enum": [
                "correct_arguments",
                "read_context",
                "stop",
                "query_receipt",
                "execution_policy",
                "report_defect"
              ],
              "title": "Action",
              "type": "string"
            },
            "run_id": {
              "title": "Run Id",
              "type": "string"
            },
            "call_id": {
              "title": "Call Id",
              "type": "string"
            },
            "diagnostic_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Diagnostic Id"
            },
            "issues": {
              "items": {
                "$ref": "#/$defs/FieldIssue"
              },
              "maxItems": 100,
              "title": "Issues",
              "type": "array"
            }
          },
          "required": [
            "code",
            "category",
            "message",
            "action",
            "run_id",
            "call_id"
          ],
          "title": "ToolFailure",
          "type": "object"
        }
      ],
      "$defs": {
        "FieldIssue": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "title": "Path",
              "type": "array"
            },
            "code": {
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "path",
            "code",
            "message"
          ],
          "title": "FieldIssue",
          "type": "object"
        }
      }
    }
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApiMockJobEventContract": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "job_update",
            "job_done"
          ],
          "title": "Type",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "job": {
          "$ref": "#/$defs/ApiMockJobResponse"
        }
      },
      "required": [
        "type",
        "project_id",
        "job"
      ],
      "title": "ApiMockJobEventContract",
      "type": "object"
    },
    "ApiMockJobResponse": {
      "properties": {
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "attempt_count": {
          "default": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobCompletion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "creator_id": {
          "title": "Creator Id",
          "type": "string"
        },
        "job_type": {
          "title": "Job Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "WAITING_HITL",
            "INTERRUPTED",
            "TERMINATING",
            "ORPHANED",
            "SUCCESS",
            "FAILED",
            "CANCELLED",
            "REVERTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "result_json": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiMockJobResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "iso-date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "iso-date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "iso-date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "iso-date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        }
      },
      "required": [
        "id",
        "project_id",
        "creator_id",
        "job_type",
        "status",
        "progress",
        "created_at"
      ],
      "title": "ApiMockJobResponse",
      "type": "object"
    },
    "ApiMockJobResult": {
      "additionalProperties": false,
      "description": "Business result and cancellation metadata, shared by HTTP and WebSocket.",
      "properties": {
        "job_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }

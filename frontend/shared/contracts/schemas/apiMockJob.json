{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApiMockJobResult": {
      "description": "Business result and cancellation metadata, shared by HTTP and WebSocket.",
      "properties": {
        "job_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Kind"
        },
        "target_endpoint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Endpoint Id"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "endpoints_imported": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoints Imported"
        },
        "cases_created": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cases Created"
        },
        "created_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created Count"
        },
        "updated_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated Count"
        },
        "cancel_requested": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Requested"
        },
        "cancel_requested_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Requested At"
        },
        "cancelled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelled"
        },
        "cancelled_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelled At"
        }
      },
      "title": "ApiMockJobResult",
      "type": "object"
    },
    "JobArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "JobArtifact",
      "type": "object"
    },
    "JobCompletion": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "SUCCESS",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/JobArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "committed_at": {
          "format": "iso-date-time",
          "title": "Committed At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "outcome",
        "summary",
        "attempt",
        "committed_at"
      ],
      "title": "JobCompletion",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "attempt_count": {
      "default": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "completion": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobCompletion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "creator_id": {
      "title": "Creator Id",
      "type": "string"
    },
    "job_type": {
      "title": "Job Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "WAITING_HITL",
        "INTERRUPTED",
        "TERMINATING",
        "ORPHANED",
        "SUCCESS",
        "FAILED",
        "CANCELLED",
        "REVERTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "progress": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress",
      "type": "integer"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "result_json": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiMockJobResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "iso-date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "iso-date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "iso-date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "iso-date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    }
  },
  "required": [
    "id",
    "project_id",
    "creator_id",
    "job_type",
    "status",
    "progress",
    "created_at"
  ],
  "title": "ApiMockJobResponse",
  "type": "object"
}

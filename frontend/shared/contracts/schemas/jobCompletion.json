{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JobArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "JobArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/JobArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "committed_at": {
      "format": "iso-date-time",
      "title": "Committed At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "outcome",
    "summary",
    "attempt",
    "committed_at"
  ],
  "title": "JobCompletion",
  "type": "object"
}

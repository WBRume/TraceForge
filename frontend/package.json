{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "SDD Native Electron desktop client",
  "author": "SDD Native",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:electron:main": "vite build --config vite.electron.config.ts",
    "build:electron": "npm run build && npm run build:electron:main && electron-builder",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"vite build --config vite.electron.config.ts --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "axios": "^1.13.6",
    "cross-spawn": "^7.0.6",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "lucide-vue-next": "^0.577.0",
    "mockjs": "^1.1.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.4",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.2.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.sddnative.desktop",
    "productName": "SDD Native",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

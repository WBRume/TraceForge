{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "task-float",
  "description": "Read-only task preview in a local desktop window",
  "windows": ["task-float-*"],
  "permissions": [
    "allow-task-float-controls",
    "core:window:allow-start-dragging",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    }
  ]
}

# SDD Native Platform backend configuration.
# Copy this file to backend/.env and adjust values for your machine.

# App
APP_NAME=SDD Native Platform
APP_VERSION=1.0.0
DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=sdd_platform

# JWT authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Agent backend switch (claude-code | opencode | dsh | mock; default claude-code)
AGENT_BACKEND=claude-code
OPENCODE_SERVER_URL=http://127.0.0.1:4097
DSH_CLI_PATH=dsh
# Set this to use DSH Web Host server mode (resume/fork/streaming); leave empty for headless CLI.
# DSH_SERVER_URL=http://127.0.0.1:3080

# Claude CLI bridge
SDD_CLI_MODE=real
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT=300
AGENT_STARTUP_TIMEOUT_SECONDS=60
AGENT_IDLE_TIMEOUT_SECONDS=600
AGENT_MAX_RUNTIME_SECONDS=7200
PLATFORM_API_BASE_URL=http://localhost:8000

# Workflow and local storage paths
MAX_RETRY_COUNT=3
SKILLS_STORAGE_ROOT=storage/skills
SKILL_MAX_TEXT_FILE_SIZE_BYTES=10485760
API_MOCK_TEMP_ROOT=tmp/api_mock_workspace
CLI_STATE_ROOT=tmp/cli_state
WORKSPACE_ARCHIVE_ROOT=tmp/workspace_archive
CLI_BOOTSTRAP_TIMEOUT=1800
CLI_CLEANUP_RETRY_COUNT=5
CLI_CLEANUP_RETRY_INTERVAL_MS=600
SKILL_GITHUB_IMPORT_GIT_TIMEOUT_SECONDS=240
SKILL_GITHUB_IMPORT_STALE_GRACE_SECONDS=60
TASK_CHANGE_MAX_UPLOAD_BYTES=10485760
TASK_CHANGE_DIFF_EXCERPT_CHARS=12000
TASK_CHANGE_PROPOSAL_QUEUE_WAIT_TIMEOUT_SECONDS=120.0
TASK_CHANGE_PROPOSAL_QUEUE_POLL_INTERVAL_SECONDS=0.1

# CORS. Keep this as JSON so pydantic-settings can parse the list.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:5177","http://localhost:5178","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175","http://127.0.0.1:5176","http://127.0.0.1:5177","http://127.0.0.1:5178","null","http://localhost:3000"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
AI_SESSION_LOG_DIR=logs/ai_sessions
LOG_JSON_FILES=true
LOG_ROTATION=5 MB
LOG_RETENTION=10 days
LOG_ENQUEUE=true

# Redis / distributed lock. Use redis only when a Redis service is available.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=3.0
REDIS_CONNECT_TIMEOUT_SECONDS=3.0
DISTRIBUTED_LOCK_BACKEND=local
DISTRIBUTED_LOCK_KEY_PREFIX=sdd-native
DISTRIBUTED_LOCK_DEFAULT_TTL_SECONDS=60
DISTRIBUTED_LOCK_BLOCKING_TIMEOUT_SECONDS=5.0
DISTRIBUTED_LOCK_SLEEP_SECONDS=0.1
DISTRIBUTED_LOCK_ALLOW_LOCAL_FALLBACK=false

# Lock TTLs and queue tuning
TASK_LOCK_TTL_SECONDS=120
SKILL_LOCK_TTL_SECONDS=120
WORKSPACE_LOCK_TTL_SECONDS=180
AI_JOB_LOCK_TTL_SECONDS=60
BOOTSTRAP_LOCK_TTL_SECONDS=300
CHAT_MESSAGE_IDEMPOTENCY_TTL_SECONDS=86400
TASK_CREATE_QUEUE_WAIT_TIMEOUT_SECONDS=120.0
TASK_CREATE_QUEUE_POLL_INTERVAL_SECONDS=0.1
BACKGROUND_QUEUE_WAIT_TIMEOUT_SECONDS=900.0
BACKGROUND_QUEUE_POLL_INTERVAL_SECONDS=0.1
BACKGROUND_QUEUE_DEFAULT_MAX_CONCURRENT=2
PROVISION_QUEUE_MAX_CONCURRENT=2
API_MOCK_QUEUE_MAX_CONCURRENT=2
BOOTSTRAP_QUEUE_MAX_CONCURRENT=2

# RAG adapter layer (Currently only the adapter is implemented; specific platform integration later)
RAG_ENABLED=false
RAG_PROVIDER=mock          # mock | httpx; WeKnora/LLMWiki adapters will be added later
RAG_API_BASE_URL=
RAG_API_KEY=
RAG_API_TIMEOUT_SECONDS=10
RAG_INGEST_BATCH_SIZE=20
RAG_INGEST_INTERVAL_SECONDS=5.0
RAG_RETRY_MAX=5
RAG_RETRY_BACKOFF_BASE_SECONDS=2

# 复制为 api.env 后按实际环境修改。所有值以容器网络内的服务名互访。
# ⚠️ env_file 不做变量展开，这里必须写最终值。

APP_NAME=SDD Native Platform
APP_VERSION=1.0.0
DEBUG=false

# ── 数据库（服务名 mysql，非 localhost）──
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=sdd_platform
SQL_ECHO=false

# ── JWT：生产环境必须换成随机长密钥 ──
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_REFRESH_TOKEN_DAYS=30

# ── Redis / 分布式锁（服务名 redis）──
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
DISTRIBUTED_LOCK_BACKEND=redis
DISTRIBUTED_LOCK_ALLOW_LOCAL_FALLBACK=false

# ── Agent / CLI ──
AGENT_BACKEND=claude-code
SDD_CLI_MODE=real
CLAUDE_CLI_PATH=claude
# Linux 下靠 psutil + /proc run-token 做进程收敛；开启后无收敛能力会拒绝 spawn
AGENT_REQUIRE_PROCESS_CONTAINMENT=true
# 使用 API Key 认证时填这里，并去掉 compose 中的 ~/.claude 挂载
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ── 存储路径：容器部署必须用绝对路径 ──
SKILLS_STORAGE_ROOT=/app/storage/skills
API_MOCK_TEMP_ROOT=/app/tmp/api_mock_workspace
CLI_STATE_ROOT=/app/tmp/cli_state
WORKSPACE_ARCHIVE_ROOT=/app/tmp/workspace_archive
LOG_DIR=/app/logs
AI_SESSION_LOG_DIR=/app/logs/ai_sessions
LOG_JSON_FILES=true
LOG_LEVEL=INFO

# 后端自检回调地址（容器间用服务名）
PLATFORM_API_BASE_URL=http://api:8000
WORKER_SERVICE_NAME=traceforge-api
WORKER_INDEX=0

# ── CORS：默认只放行 localhost，容器部署必须改成实际访问域名 ──
# 例：["https://traceforge.internal.example.com"]
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# 有域名时放开注释并收紧为你的域名；无域名保留 localhost 规则
# CORS_ORIGIN_REGEX=^https?://(traceforge\.internal\.example\.com|localhost|127\.0\.0\.1)(:\d+)?$
FRONTEND_BASE_URL=http://localhost:8080

# ── OAuth（按需启用，CLIENT_ID 留空 = 关闭）──
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI_WEB=
# 生产环境必须保持 false
OAUTH_STUB_ENABLED=false

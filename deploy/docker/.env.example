# TraceForge Docker Compose 基础部署配置
# 复制为 .env，仅设置基础设施与持久密钥；高级能力在系统配置中在线管理。
# 业务变量仍支持环境兜底，完整变量列表见 backend/.env.example。
DEBUG=false
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=sdd_platform
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=sdd_platform

# 初次部署设置并持久保存。未指定独立配置主密钥时由 JWT 主密钥派生。
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
FEATURE_CONFIG_MASTER_KEY=

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
DISTRIBUTED_LOCK_BACKEND=redis
DISTRIBUTED_LOCK_ALLOW_LOCAL_FALLBACK=false

WEB_PORT=8080
FRONTEND_BASE_URL=http://localhost:8080
PLATFORM_API_BASE_URL=http://api:8000
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# 容器内持久化路径
SKILLS_STORAGE_ROOT=/app/storage/skills
CLI_STATE_ROOT=/app/tmp/cli_state
WORKSPACE_ARCHIVE_ROOT=/app/tmp/workspace_archive
API_MOCK_TEMP_ROOT=/app/tmp/api_mock_workspace
LOG_DIR=/app/logs
AI_SESSION_LOG_DIR=/app/logs/ai_sessions

# 默认轻量检索；Elasticsearch 和向量服务可在界面中录入。
SEARCH_ES_URL=
SEARCH_SQLITE_PATH=/app/storage/search/search-bm25.sqlite3
